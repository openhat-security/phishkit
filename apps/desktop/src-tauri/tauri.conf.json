{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phishkit",
  "version": "0.1.1-alpha.6",
  "identifier": "com.phishkit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "phishkit",
        "width": 1100,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODBBQkZCQzM4MEMzN0EKUldSNnc0REQrNnVBb3lvWnlSR210OHpSbjF6bkNOeWxLS1JIbTRlNVQvN3g2M0prQi9udHZUSEcK",
      "endpoints": [
        "https://github.com/openhat-security/phishkit/releases/latest/download/latest.json"
      ]
    }
  }
}
